{
  "name": "env-ribbon",
  "version": "0.1.0",
  "description": "A corner ribbon that shows whether a Next.js app is running LOCAL or PREVIEW. Never renders in production.",
  "license": "MIT",
  "author": "k0kishima",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./detect": {
      "types": "./dist/detect.d.ts",
      "default": "./dist/detect.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "nextjs",
    "vercel",
    "environment",
    "ribbon",
    "badge",
    "preview",
    "banner",
    "react-server-components"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0kishima/env-ribbon.git"
  },
  "bugs": {
    "url": "https://github.com/k0kishima/env-ribbon/issues"
  },
  "homepage": "https://github.com/k0kishima/env-ribbon#readme",
  "packageManager": "pnpm@10.27.0"
}
